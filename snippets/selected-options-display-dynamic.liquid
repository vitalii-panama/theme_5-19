{% comment %}
  Dynamic Selected Options Display
  This component displays selected options and integrates with the vectary-embed state management.
  
  Parameters:
  - products: Array of product data with level, name, price
  - state: Object containing color values and other state
{% endcomment %}

<!-- Spacer div to prevent content from being hidden behind the sticky bar -->

<!-- Main sticky container -->
<div class="sticky-options-container" id="sticky-options-container">
  <!-- Floating pill-shaped toggle button (mobile only) -->
  <div class="mobile-toggle-button" id="mobile-toggle-button">
    <div class="toggle-dot"></div>
    <span class="toggle-text">Selected Options</span>
    <div class="toggle-dot"></div>
  </div>

  <!-- Main content wrapper -->
  <div class="sticky-options-content" id="sticky-options-content">
    <!-- Header bar -->
    <div class="sticky-options-header">
      <div class="header-left">
        
        <h2>Selected Options</h2>
      </div>
      <div class="header-right">
        <button class="close-button" id="close-button">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>
    
    <!-- Content scrollable area -->
    <div class="sticky-options-scrollable">
      <!-- Selected levels section -->
      <div class="sticky-section">
        <div class="sticky-section-header">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"></path>
            <path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"></path>
            <path d="M7 21h10"></path>
            <path d="M12 3v18"></path>
            <path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"></path>
          </svg>
          <h3>Selected Levels</h3>
        </div>
        <div id="selected-levels-container" class="selected-levels">
          <!-- Level items will be populated here by JavaScript -->
        </div>
      </div>
      
      <!-- Selected colors section -->
      <div class="sticky-section">
        <div class="sticky-section-header">
          <svg class="section-icon palette-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--text-color)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="13.5" cy="6.5" r="2.5"></circle>
            <circle cx="19" cy="13" r="2.5"></circle>
            <circle cx="6" cy="12.5" r="2.5"></circle>
            <circle cx="10" cy="19" r="2.5"></circle>
          </svg>
          <h3>Selected Colors</h3>
        </div>
        <div id="selected-colors-grid" class="selected-colors-grid">
          <!-- Color items will be populated here by JavaScript -->
        </div>
      </div>
    </div>

  </div>
</div>



<style>
  html {
    overflow-x: hidden;
  }
  .product-nav {
    display: flex;
    flex-direction: row;
    gap: 2rem;
    margin-bottom: 2rem;
    .btn {
      padding: 0;
    }
  }
  .page-content--product {
    padding-top: 0;
  }

  .page-content--product .grid {
    margin: 0 !important;
    width: 100%;
  }
  /* Core variables for consistent styling */
  :root {
    --primary-color: #2563eb; /* Bright blue */
    --primary-hover: #1d4ed8;
    --text-dark: #1f2937;
    --text-light: #6b7280;
    --background-light: #ffffff;
    --background-off: #f9fafb;
    --border-light: #e5e7eb;
    --border-focus: #93c5fd;
    --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    --radius-sm: 0.375rem;
    --radius-md: 0.5rem;
    --radius-lg: 0.75rem;
    --radius-full: 9999px;
    --transition-fast: 150ms cubic-bezier(0.4, 0, 0.2, 1);
    --transition-normal: 300ms cubic-bezier(0.4, 0, 0.2, 1);
    --font-sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji';
  }

  /* Spacer for content adjustment */
  #sticky-spacer {
    height: var(--sticky-height, 0px);
    transition: height var(--transition-normal);
  }

  /* Main container */
  .sticky-options-container-atc {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 1000000;
    font-family: var(--font-sans);
    color: var(--text-dark);
    transition: transform var(--transition-normal), opacity var(--transition-normal);
  }
  .product-single__sticky {
    padding-left: 0;
    padding-right: 0;
  }
  /* Mobile toggle button - pill-shaped indicator */
  .mobile-toggle-button {
    position: absolute;
    top: -22px;
    left: 50%;
    transform: translateX(-50%);
    background-color: var(--secondary);
    color: white;
    border-radius: var(--radius-full);
    padding: 6px 16px;
    display: flex;
    align-items: center;
    gap: 8px;
    box-shadow: var(--shadow-md);
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 500;
    z-index: 10;
    border: 2px solid rgba(255, 255, 255, 0.2);
    transition: all var(--transition-normal);
  }

  .mobile-toggle-button:hover {
    background-color: var(--primary-hover);
  }

  .toggle-dot {
    width: 6px;
    height: 6px;
    background-color: white;
    border-radius: 50%;
    opacity: 0.8;
  }

  .toggle-text {
    white-space: nowrap;
  }

  /* Main content wrapper */
  .sticky-options-content {
    background-color: #f9fafb;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    display: flex;
    flex-direction: column;
    max-height: 85vh;
    border: 1px solid var(--border-light);
    border-bottom: none;
    border-radius: .5rem;
    box-shadow: 0 1px 3px #0000001a;
  }

  /* Header bar */
  .sticky-options-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 20px;
    background-color: var(--background-light);
    border-bottom: 1px solid var(--border-light);
    position: relative;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .header-left h2 {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0;
    color: var(--text-dark);
  }

  .cart-icon {
    color: var(--primary-color);
  }

  .close-button {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-light);
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color var(--transition-fast);
  }

  .close-button:hover {
    background-color: rgba(0, 0, 0, 0.05);
    color: var(--text-dark);
  }

  /* Scrollable content area */
  .sticky-options-scrollable {
    overflow-y: auto;
    padding: 0 20px;
    flex: 1;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: var(--border-light) transparent;
  }

  .sticky-options-scrollable::-webkit-scrollbar {
    width: 6px;
  }

  .sticky-options-scrollable::-webkit-scrollbar-track {
    background: transparent;
  }

  .sticky-options-scrollable::-webkit-scrollbar-thumb {
    background-color: var(--border-light);
    border-radius: var(--radius-full);
  }

  /* Section styling */
  .sticky-section {
    padding: 16px 0;
    border-bottom: 1px solid var(--border-light);
  }

  .sticky-section:last-child {
    border-bottom: none;
  }

  .sticky-section-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }

  .section-icon {
    color: var(--primary-color);
  }

  .sticky-section-header h3 {
    font-size: 12px;
    font-weight: 600;
    margin: 0;
    color: var(--text-dark);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Selected levels styling */
  .selected-levels {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
  }

  .level-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0;
    background-color: var(--background-off);
    border-radius: var(--radius-md);
    transition: background-color var(--transition-fast);
  }

  .level-item:hover {
    background-color: #f3f4f6;
  }
  .level-info {
    display: flex;
    align-items: center;
    gap: 8px;
    @media (max-width: 768px) {
      flex-direction: column-reverse;
    }
  }
  .level-item span {
    font-size: 12px;
    font-weight: 500;
    color: var(--text-dark);
    margin: 0;
  }

  .remove-button {
    display: none!important;
    background: none;
    border: none;
    cursor: pointer;
    color: #ef4444;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color var(--transition-fast);
  }

  .remove-button:hover {
    background-color: rgba(239, 68, 68, 0.1);
  }

  .remove-button svg {
    width: 16px;
    height: 16px;
  }

  /* Selected colors styling */
  .selected-colors-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 10px;
  }

  .color-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0;
    background-color: var(--background-off);
    border-radius: var(--radius-md);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .color-item:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
  }

  .color-swatch {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 2px solid white;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.1);
    flex-shrink: 0;
  }

  .color-name {
    font-size: 12px;  
    font-weight: 500;
    color: var(--text-dark);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Footer with checkout button */
  .sticky-options-footer {
    padding: 16px 20px;
    background-color: var(--background-light);
    border-top: 1px solid var(--border-light);
  }

  .checkout-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background-color: var(--secondary);
    color: white;
    border: none;
    border-radius: var(--radius-md);
    padding: 14px 20px;
    font-size: 1rem;
    font-weight: 500;
    cursor: pointer;
    width: 100%;
    transition: background-color var(--transition-fast), transform var(--transition-fast);
  }

  .checkout-button:hover {
    background-color: var(--primary);
    transform: translateY(-1px);
  }

  .checkout-button:active {
    transform: translateY(0);
  }

  .checkout-arrow {
    transition: transform var(--transition-fast);
  }

  .checkout-button:hover .checkout-arrow {
    transform: translateX(3px);
  }

  .color-selection-notice {
    font-size: 0.8rem;
    color: var(--text-light);
    text-align: center;
    margin-top: 10px;
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .product_desc_item, .product-single__meta {
      padding-left: 0;
      padding-right: 0;
    }
    .sticky-options-content {
      max-height: 75vh;
    }

    .selected-colors-grid {
      grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    }
  }

  @media (max-width: 640px) {
    .sticky-options-header {
      padding: 14px 16px;
    }

    .sticky-options-scrollable {
      padding: 0 16px;
    }

    .sticky-options-footer {
      padding: 14px 16px;
    }

    .checkout-button {
      padding: 12px 16px;
    }

    .selected-colors-grid {
      grid-template-columns: 1fr 1fr;
    }


    .color-swatch {
      width: 20px;
      height: 20px;
    }

    .level-item {
      padding: 10px 12px;
    }
  }

  /* Animation classes */
  .sticky-hidden {
    transform: translateY(100%);
    opacity: 0;
  }

  .sticky-visible {
    transform: translateY(0);
    opacity: 1;
  }

  .sticky-collapsed .sticky-options-scrollable,
  .sticky-collapsed .sticky-options-footer {
    display: none;
  }

  .sticky-collapsed .mobile-toggle-button {
    opacity: 0.9;
  }
  #sticky-options-container {
  {% comment %} display: none!important; {% endcomment %}
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Get references to key elements
    const stickyContainer = document.getElementById('sticky-options-container');
    const stickyContent = document.getElementById('sticky-options-content');
    const spacer = document.getElementById('sticky-spacer');
    const closeButton = document.getElementById('close-button');
    const mobileToggleButton = document.getElementById('mobile-toggle-button');
    
    // Initialize with visible state
    let isVisible = true;
    let isCollapsed = false;
    
    // Function to update the spacer height to match the content
    function updateSpacerHeight() {
      if (spacer && stickyContent && isVisible) {
        const height = stickyContent.offsetHeight;
        document.documentElement.style.setProperty('--sticky-height', `${height}px`);
        spacer.style.height = `${height}px`;
      } else if (spacer && !isVisible) {
        spacer.style.height = '0px';
      }
    }
    
    // Toggle visibility of the entire container
    function toggleVisibility() {
      if (!stickyContainer) return;
      
      if (isVisible) {
        // Hide the container
        stickyContainer.classList.add('sticky-hidden');
        stickyContainer.classList.remove('sticky-visible');
        // Show only the toggle button
        mobileToggleButton.style.top = '-10px';
      } else {
        // Show the container
        stickyContainer.classList.remove('sticky-hidden');
        stickyContainer.classList.add('sticky-visible');
        // Restore toggle button position
        mobileToggleButton.style.top = '-22px';
      }
      
      isVisible = !isVisible;
      updateSpacerHeight();
    }
    
    // Toggle collapsed state (for mobile)
    function toggleCollapsed() {
      if (!stickyContainer) return;
      
      if (isCollapsed) {
        // Expand the container
        stickyContainer.classList.remove('sticky-collapsed');
      } else {
        // Collapse the container
        stickyContainer.classList.add('sticky-collapsed');
      }
      
      isCollapsed = !isCollapsed;
      updateSpacerHeight();
    }
    
    // Set up event listeners
    if (closeButton) {
      closeButton.addEventListener('click', toggleVisibility);
    }
    
    if (mobileToggleButton) {
      mobileToggleButton.addEventListener('click', function() {
        if (!isVisible) {
          toggleVisibility(); // Show if currently hidden
        } else if (window.innerWidth <= 768) {
          toggleCollapsed(); // Toggle collapse state on mobile
        }
      });
    }
    
    // Update height on window resize
    window.addEventListener('resize', updateSpacerHeight);
    
    // Initialize height calculation
    window.addEventListener('load', function() {
      // Add visible class for smooth initial appearance
      if (stickyContainer) {
        stickyContainer.classList.add('sticky-visible');
      }
      updateSpacerHeight();
    });
    
    // Add smooth scrolling for the scrollable area
    const scrollableArea = document.querySelector('.sticky-options-scrollable');
    if (scrollableArea) {
      scrollableArea.addEventListener('wheel', function(e) {
        const delta = e.deltaY;
        this.scrollTop += delta;
        e.preventDefault();
      }, { passive: false });
    }
    // This script will be initialized from vectary-embed.liquid
    window.initSelectedOptionsDisplay = function(products, colorSwatchesData, appState) {
      // Update spacer height when content changes
      function updateLayout() {
        const spacer = document.getElementById('sticky-spacer');
        const content = document.getElementById('sticky-options-content');
        if (spacer && content) {
          const height = content.offsetHeight;
          document.documentElement.style.setProperty('--sticky-height', `${height}px`);
          spacer.style.height = `${height}px`;
        }
      }
      
      // Populate selected levels
      const selectedLevelsContainer = document.getElementById('selected-levels-container');
      if (selectedLevelsContainer) {
        selectedLevelsContainer.innerHTML = '';
        
        if (!products || products.length === 0) {
          const emptyMessage = document.createElement('div');
          emptyMessage.className = 'empty-message';
          emptyMessage.textContent = 'No levels selected';
          selectedLevelsContainer.appendChild(emptyMessage);
        } else {
          // Add all products to the display
          products.forEach((product,i) => {
            const levelItem = document.createElement('div');
            levelItem.className = 'level-item';
            levelItem.setAttribute('data-level', product.level);
            
            const levelInfo = document.createElement('div');
            levelInfo.className = 'level-info';
            
            const levelName = document.createElement('span');
            levelName.className = 'level-name';
            levelName.textContent = 'Level ' + (i + 1);
            
            // Add price if available
            if (product.price) {
              const levelPrice = document.createElement('span');
              levelPrice.className = 'level-price';
              levelPrice.textContent = product.price;
              levelInfo.appendChild(levelPrice);
            }
            
            levelInfo.appendChild(levelName);
            
            const removeButton = document.createElement('button');
            removeButton.className = 'remove-button';
            removeButton.setAttribute('data-level', product.level);
            removeButton.setAttribute('aria-label', `Remove ${product.name}`);
            removeButton.innerHTML = `
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            `;
            
            // Add click handler for remove button
            removeButton.addEventListener('click', function() {
              const level = this.getAttribute('data-level');
              const levelEvent = new CustomEvent('selected-options-remove-level', {
                detail: { level: parseInt(level) }
              });
              document.dispatchEvent(levelEvent);
              
              // Animate removal with fade out
              levelItem.style.opacity = '0';
              levelItem.style.height = '0';
              levelItem.style.marginTop = '0';
              levelItem.style.marginBottom = '0';
              levelItem.style.padding = '0';
              levelItem.style.overflow = 'hidden';
              
              // Remove from DOM after animation
              setTimeout(() => {
                levelItem.remove();
                updateLayout();
                
                // Check if there are no more levels
                if (selectedLevelsContainer.children.length === 0) {
                  const emptyMessage = document.createElement('div');
                  emptyMessage.className = 'empty-message';
                  emptyMessage.textContent = 'No levels selected';
                  selectedLevelsContainer.appendChild(emptyMessage);
                }
              }, 300);
            });
            
            levelItem.appendChild(levelInfo);
            levelItem.appendChild(removeButton);
            selectedLevelsContainer.appendChild(levelItem);
          });
        }
      }
      
      // Populate selected colors
      updateColorGrid(colorSwatchesData, appState);
      
      // Set up checkout button
      const checkoutButton = document.getElementById('selected-options-checkout-button');
      if (checkoutButton) {
        checkoutButton.addEventListener('click', function() {
          // Show loading state
          const originalText = checkoutButton.innerHTML;
          checkoutButton.innerHTML = `
            <svg class="loading-spinner" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M12 6v6l4 2"></path>
            </svg>
            Processing...
          `;
          checkoutButton.disabled = true;
          
          // Add selected colors as line item properties before checkout
          const colorKeys = Object.keys(appState.colorValues);
          const colorProperties = {};
          
          // Create line item properties for each color choice
          colorKeys.forEach(colorKey => {
            const colorValue = appState.colorValues[colorKey];
            const keyA = `A${colorValue}`;
            const keyB = `B${colorValue}`;
            
            // Get color name and hex
            const colorName = colorSwatchesData[keyA] || 'Unknown';
            const hexColor = colorSwatchesData[keyB] || '#FFFFFF';
            
            // Format the key and value in a standardized way
            const propertyKey = `Color_${colorKey.replace(/[^a-zA-Z0-9]/g, '')}`;
            const propertyValue = `${colorName} (${hexColor})`;
            
            // Add to properties object
            colorProperties[propertyKey] = propertyValue;
          });
          
          // Save color selections to cart
          fetch('/cart/update.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({ attributes: colorProperties })
          })
          .then(response => response.json())
          .then(cart => {
            console.log('Cart updated with color properties:', cart);
            
            // Reset button state
            checkoutButton.innerHTML = originalText;
            checkoutButton.disabled = false;
            
            // Dispatch the checkout event after saving colors to cart
            const checkoutEvent = new CustomEvent('selected-options-checkout', {
              detail: { colorProperties: colorProperties }
            });
            document.dispatchEvent(checkoutEvent);
          })
          .catch(error => {
            console.error('Error updating cart with color properties:', error);
            
            // Reset button state
            checkoutButton.innerHTML = originalText;
            checkoutButton.disabled = false;
            
            // Still dispatch the checkout event even if there was an error
            const checkoutEvent = new CustomEvent('selected-options-checkout');
            document.dispatchEvent(checkoutEvent);
          });
        });
      }
      
      // Run layout update after everything is initialized
      setTimeout(updateLayout, 100);
    };
    
    // Helper function to update color grid
    function updateColorGrid(colorSwatchesData, appState) {
      const selectedColorsGrid = document.getElementById('selected-colors-grid');
      if (selectedColorsGrid && appState && colorSwatchesData) {
        selectedColorsGrid.innerHTML = '';
        
        // Get color keys (C5, C4, C3, C2, C1, BG)
        const colorKeys = Object.keys(appState.colorValues);
        
        if (colorKeys.length === 0) {
          const emptyMessage = document.createElement('div');
          emptyMessage.className = 'empty-message';
          emptyMessage.textContent = 'No colors selected';
          selectedColorsGrid.appendChild(emptyMessage);
          return;
        }
        
        // For each color, create a color item
        colorKeys.forEach(colorKey => {
          const colorValue = appState.colorValues[colorKey];
          const keyA = `A${colorValue}`;
          const keyB = `B${colorValue}`;
          
          const colorName = colorSwatchesData[keyA] || 'Unknown';
          const hexColor = colorSwatchesData[keyB] || '#FFFFFF';
          
          const colorItem = document.createElement('div');
          colorItem.className = 'color-item';
          
          const colorSwatch = document.createElement('div');
          colorSwatch.className = 'color-swatch';
          colorSwatch.style.backgroundColor = hexColor;
          
          const colorNameSpan = document.createElement('span');
          colorNameSpan.className = 'color-name';
          colorNameSpan.textContent = `${colorKey}: ${colorName}`;
          
          // Add tooltip on hover
          colorItem.setAttribute('title', `${colorKey}: ${colorName} (${hexColor})`);
          
          colorItem.appendChild(colorSwatch);
          colorItem.appendChild(colorNameSpan);
          selectedColorsGrid.appendChild(colorItem);
          
          // Add animation effect
          setTimeout(() => {
            colorItem.style.opacity = '1';
            colorItem.style.transform = 'translateY(0)';
          }, 50 * colorKeys.indexOf(colorKey));
        });
      }
    }
    
    // Public method to update display when state changes
    window.updateSelectedOptionsDisplay = function(colorSwatchesData, appState) {
      updateColorGrid(colorSwatchesData, appState);
      
      // Update layout after colors are updated
      setTimeout(() => {
        const spacer = document.getElementById('sticky-spacer');
        const content = document.getElementById('sticky-options-content');
        if (spacer && content) {
          const height = content.offsetHeight;
          document.documentElement.style.setProperty('--sticky-height', `${height}px`);
          spacer.style.height = `${height}px`;
        }
      }, 100);
    };
  });
</script> 