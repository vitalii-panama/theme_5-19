{%- assign current_variant = product.selected_or_first_available_variant -%}
{{ 'vectary-styles.css' | asset_url | stylesheet_tag }}
<div class="hide-desktop">
  {%- render 'breadcrumbs' -%}
</div>
<div class="product-nav hide-desktop clearfix">
  {% if collection.previous_product %}<div class="btn btn--secondary btn--small">{% endif %}
  <span style="float:left;">
    {%- if collection.previous_product %}
      {{ '&larr; See Previous' | link_to: collection.previous_product }}
    {% endif -%}
  </span>
  {% if collection.previous_product %}</div>{% endif %}
  {% if collection.next_product %}<div class="btn btn--secondary btn--small">{% endif %}
  <span style="float:right;">
    {%- if collection.next_product %}
      {{ 'See Next &rarr;' | link_to: collection.next_product }}
    {% endif -%}
  </span>
  {% if collection.next_product %}</div>{% endif %}
</div>
<iframe
  id="VECTARY_EMBED_ID"
  src="https://app.vectary.com/p/{{ product.metafields.global.vectary_project_id | default: '2q7N616SvwLKnWUhIOogUi' }}"
  frameborder="0"
  allowfullscreen
></iframe>

{% comment %}
  <iframe
    id="VECTARY_EMBED_ID"
    src="https://app.vectary.com/p/4D6fSi02LObh3AD5quFrbA"
    frameborder="0"
    allowfullscreen
  ></iframe>
{% endcomment %}

{% render 'selected-options-display-dynamic' %}

<script type="module" src="{{ 'vectary-scripts.js' | asset_url }}" defer></script>