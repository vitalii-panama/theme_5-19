</div>

    <div class="level-buttons">
      <h3 class="section-title">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          style="margin-right: 8px"
        >
          <path
            d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"
          ></path>
          <path
            d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"
          ></path>
          <path d="M7 21h10"></path>
          <path d="M12 3v18"></path>
          <path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"></path>
        </svg>
        Material Visibility Controls
      </h3>

      <div class="level-grid">
        {%- if product.metafields.custom.materials -%}
          {%- for material_item in product.metafields.custom.materials.value -%}
            {%- if material_item -%}
              <button
                id="triggerButtonLevel{{ forloop.index }}"
                class="level-button active"
                data-level-handle="{{ material_item.title | downcase | replace: ' ', '-' }}"
                data-id="{{ material_item.selected_or_first_available_variant.id }}"
                data-material-title="{{ material_item.title }}"
                style="--bg: {{ material_item.metafields.custom.material_display }};"
              >
                <span>{{ material_item.title }}</span>
                <span class="level-price">{{ material_item.price | money }}</span>
              </button>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    <div class="overlaminate-buttons">
      <h3 class="section-title">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          style="margin-right: 8px"
        >
          <path d="M12 3v12"></path>
          <path d="m8 11 4 4 4-4"></path>
          <path d="M8 5H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-4"></path>
        </svg>
        Overlaminate Options
      </h3>

      <div class="overlaminate-grid">
        {%- if product.metafields.custom.overlaminate -%}
          {%- for overlaminate_item in product.metafields.custom.overlaminate.value -%}
            {%- if overlaminate_item -%}
              <button
                id="overlaminate{{ overlaminate_item.title | replace: ' ', '' }}"
                data-material="{{ overlaminate_item.material }}"
                class="overlaminate-button"
                data-overlaminate-handle="{{ overlaminate_item.title }}"
                data-id="{{ overlaminate_item.selected_or_first_available_variant.id }}"
                style="--bg: {{ overlaminate_item.metafields.custom.material_display }};{% if overlaminate_item.metafields.custom.repeat_bg_pattern %}background-size: 12px 12px;background-repeat: repeat;{% endif %};background-color: #f0f0f0;"
                
              >
                <span>{{ overlaminate_item.title }}</span>
                <span class="overlaminate-price">{{ overlaminate_item.price | money }}</span>
              </button>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>

<div class="placeholder-area">
  <h3>Future Actions Area</h3>
  <div class="placeholder-buttons">
    <!-- Example: attach to Action 1 -->
   <!-- Download Image Button -->
    <button id="download-image" class="btn btn-outline">Download Image</button>
    <button class="btn btn-outline">Action 2</button>
    <button class="btn btn-outline">Action 3</button>
  </div>
</div>

<script>
   window.mainProduct = {
     handle: "{{ product.handle }}",
     id: "{{ product.selected_or_first_available_variant.id }}",
     price: "{{ product.price | money }}"
   }
   window.globalProductData = {
     {%- if product.metafields.custom.materials -%}
       {%- for material_item in product.metafields.custom.materials.value -%}
         {%- if material_item -%}
           {{ forloop.index }}: {
             handle: "{{ material_item.title | downcase | replace: ' ', '-' }}",
             id: "{{ material_item.selected_or_first_available_variant.id }}",
             price: "{{ material_item.price | money }}"
           }{%- unless forloop.last -%},{%- endunless -%}
         {%- endif -%}
       {%- endfor -%}
     {%- endif -%}
   };
 
   // Add overlaminate product data
   window.overlaminateProductData = {
     {%- if product.metafields.custom.overlaminate -%}
       {%- for overlaminate_item in product.metafields.custom.overlaminate.value -%}
         {%- if overlaminate_item -%}
           "{{ overlaminate_item.title | downcase | replace: ' ', '-' }}": {
             handle: "{{ overlaminate_item.title | downcase | replace: ' ', '-' }}",
             id: "{{ overlaminate_item.selected_or_first_available_variant.id }}",
             price: "{{ overlaminate_item.price | money }}"
           }{%- unless forloop.last -%},{%- endunless -%}
         {%- endif -%}
       {%- endfor -%}
     {%- endif -%}
   };
   
   document.getElementById("importConfigButton")?.addEventListener("click", function() {
     document.getElementById("importConfigFile").click();
   });

   document.getElementById("importConfigFile")?.addEventListener("change", function(event) {
     const file = event.target.files[0];
     if (!file) return;
     const reader = new FileReader();
     reader.onload = function(e) {
       try {
         const config = JSON.parse(e.target.result);

         // Restore state from config
         if (config.activePreset !== undefined) state.activePreset = config.activePreset;
         if (config.colorValues) state.colorValues = config.colorValues;
         if (config.lockedMaterials) state.lockedMaterials = config.lockedMaterials;
         if (config.activeLevels) state.activeLevels = new Set(config.activeLevels);
         if (config.activeOverlaminates) state.activeOverlaminates = new Set(config.activeOverlaminates);

         // Update all sliders and color displays to match imported state
         Object.entries(state.colorValues).forEach(([key, value]) => {
           const slider = document.getElementById(`swatchSlider${key}`);
           if (slider) {
             slider.value = value;
             slider.dispatchEvent(new Event('input', { bubbles: true }));
           }
         });

         // Optionally, update UI to reflect imported config
         if (typeof updateUIFromState === "function") updateUIFromState();

         // Show a status message
         if (typeof statusMessage !== "undefined") statusMessage.textContent = "Configuration imported successfully";
       } catch (err) {
         alert("Failed to import configuration: " + err.message);
       }
     };
     reader.readAsText(file);
   });

document.getElementById("download-image")?.addEventListener("click", function() {
  if (window.api && typeof window.api.exportImage === "function") {
    window.api.exportImage();
  } else {
    alert("Image export is not available.");
  }
});

// Add event listeners for quick color swatches
document.addEventListener('click', function(e) {
  if (e.target.closest('.quick-swatch')) {
    const button = e.target.closest('.quick-swatch');
    const sliderId = button.getAttribute('data-slider');
    const colorValue = button.getAttribute('data-color');
    const slider = document.getElementById(sliderId);
    
    if (slider) {
      // Set the slider value
      slider.value = colorValue;
      
      // Trigger the input event to update the color
      slider.dispatchEvent(new Event('input', { bubbles: true }));
      
      // Clear active preset since we're manually setting a color
      if (typeof state !== 'undefined' && state.activePreset !== null) {
        state.activePreset = null;
        // Update preset buttons if the function exists
        if (typeof updatePresetButtons === 'function') {
          updatePresetButtons();
        }
      }
    }
  }
});

</script>
