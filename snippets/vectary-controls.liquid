            stroke-linecap="round"
            stroke-linejoin="round"
            style="margin-right: 8px"
          >
            <circle cx="19.5" cy="12.5" r="2.5"></circle>
            <circle cx="12.5" cy="19.5" r="2.5"></circle>
            <circle cx="4.5" cy="12.5" r="2.5"></circle>
            <circle cx="12.5" cy="4.5" r="2.5"></circle>
            <path d="M4 4h16"></path>
            <path d="M4 20h16"></path>
            <path d="M4 12h16"></path>
          </svg>
          Preset Color Schemes
        </div>
        <div class="action-buttons-wrap">
          <button id="saveConfigButton" class="">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#000"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              style="margin-right: 8px"
            >
              <path
                d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"
              ></path>
              <polyline points="17 21 17 13 7 13 7 21"></polyline>
              <polyline points="7 3 7 8 15 8"></polyline>
            </svg>
          </button>
          <button id="importConfigButton" class="">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#000"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              style="margin-right: 8px"
            >
              <path d="M12 3v12"></path>
              <path d="m8 11 4 4 4-4"></path>
              <path d="M8 5H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-4"></path>
            </svg>
          </button>
          <input type="file" id="importConfigFile" accept="application/json" style="display:none;">
        </div>
      </h3>

      <div class="preset-grid">
        {% for color in product.metafields.custom.presets.value %}
          {% assign preset_colors = color.colors_json.value %}
          {% assign preset_number = forloop.index %}
         
          <button id="color-{{ preset_number }}-btn" class="preset-button">
            Preset {{ preset_number }}
            <div class="preset-colors">
              {% for color in preset_colors %}
              {% assign color_key = color.color_key %}
              <div class="preset-color-dot" data-color-key="{{ color_key }}"></div>
            {% endfor %}
            </div>
          </button>
        {% endfor %}
       
      </div>
    </div>

    
    <h3 class="section-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px">
        <path d="M21 12.79A10 10 0 1 0 12 22a4 4 0 0 1 4-4h1a3 3 0 0 0 3-3v-2.21z"></path>
        <circle cx="6.5" cy="11.5" r="1.5"></circle>
        <circle cx="17.5" cy="11.5" r="1.5"></circle>
        <circle cx="12" cy="7.5" r="1.5"></circle>
        </svg>
        Color Controls
    </h3>
    


  <!-- Centered and styled Expand All Sliders button -->
  <div style="display: flex; justify-content: center; gap: 0.5rem; margin-bottom: 0.5em;">
    <button id="expandAllSliders" class="btn btn-outline expand-all-centered">Expand Sliders</button>
    <button id="randomizeButton" class="btn btn-outline expand-all-centered">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        style="margin-right: 6px"
      >
        <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path>
        <path d="M21 3v5h-5"></path>
        <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path>
        <path d="M3 21v-5h5"></path>
      </svg>
      Randomize
    </button>
  </div>

   {% for color in product.metafields.custom.color_sliders.value %}
